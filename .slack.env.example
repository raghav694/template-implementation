# Copy to .slack.env or export these in your shell.
# Bot token needs files:write. Channel ID is the C… value from Slack.
# Flavor `.env.dev` / `.env.prod` `SLACK_API_TOKEN` + `SLACK_CHANNEL_ID`
# take precedence when set (same keys as Vokey).

SLACK_API_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789
